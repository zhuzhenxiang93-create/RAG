DOCMIND_APP_MODE=lite
DOCMIND_API_PREFIX=/api
DOCMIND_LOG_LEVEL=INFO
DOCMIND_LOG_FORMAT=json
DOCMIND_DATA_DIR=
DOCMIND_MAX_UPLOAD_MB=50

DOCMIND_OCR_ENABLED=false

DOCMIND_LLM_BASE_URL=
DOCMIND_LLM_API_KEY=
DOCMIND_LLM_MODEL=

DOCMIND_EMBEDDING_PROVIDER=lite
DOCMIND_RERANKER_ENABLED=false

# General intent routing: Lite is CPU-only; LoRA loads MASSIVE-trained artifacts.
DOCMIND_INTENT_ENABLED=true
DOCMIND_INTENT_BACKEND=lite
DOCMIND_INTENT_BASE_MODEL=
DOCMIND_INTENT_ADAPTER_PATH=
DOCMIND_INTENT_LABELS_PATH=
DOCMIND_INTENT_DEVICE=auto
DOCMIND_INTENT_MAX_LENGTH=256
DOCMIND_INTENT_CONFIDENCE_THRESHOLD=0.55

# Historical domain-extension example; disabled by default.
DOCMIND_LEGAL_ENABLED=false
DOCMIND_LEGAL_BASE_MODEL=
DOCMIND_LEGAL_ADAPTER_PATH=
DOCMIND_LEGAL_SCORE_WEIGHTS_PATH=
DOCMIND_LEGAL_LABELS_PATH=
DOCMIND_LEGAL_DEVICE=auto
DOCMIND_LEGAL_MAX_LENGTH=512
